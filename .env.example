APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost
ASSET_URL=https://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production sends through Resend (MAIL_MAILER=resend). The name is what
# config/services.php reads — RESEND_API_KEY is a different application's
# spelling and will be ignored here.
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Read-only Drive access for `php artisan guests:sync` (see config/services.php).
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_GUESTS_FOLDER=1wiy9-J9zDIKv2SgFyPM-2rUegT8UnjlU

# Stripe: hosted payment links plus the secret that proves a webhook is genuine.
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK=
STRIPE_PAYMENT_LINK_RO=
STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_KEY=

# The 2026 edition's two switches — see docs/2026-go-live.md.
# Preview: an unlisted segment, noindex, `/` on the announcement page.
# Live: WCM_2026_PUBLIC=true and WCM_2026_PATH=2026, with the old segment
# listed in WCM_2026_OLD_PATHS so links already emailed keep working.
WCM_2026_PATH=2026-mulberry
WCM_2026_PUBLIC=false
WCM_2026_OLD_PATHS=

# Notices to the office: registrations, payments, sign-ins and failures.
# Empty means nothing is sent, which is the right setting for a laptop.
SLACK_WEBHOOK_URL=
